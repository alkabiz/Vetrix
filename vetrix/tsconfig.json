{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "es6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "forms/*": [
        "./components/forms/*"
      ],
      "validation/*": [
        "./lib/utils/validation/*"
      ],
      "api/*": [
        "./lib/api/*"
      ],
      "database/*": [
        "./lib/database/*"
      ],
      "types/*": [
        "./lib/types/*"
      ],
      "config/*": [
        "./lib/config/*"
      ],
      "auth/*": [
        "./lib/auth/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
